{
  "manifest_version": 3,
  "name": "Financial Institution Scraper",
  "version": "0.1.4",
  "description": "Log into supported financial institutions and scrape configured values into a side panel.",
  "permissions": ["storage", "scripting", "tabs", "sidePanel", "debugger"],
  "host_permissions": [
    "https://www.northwesternmutual.com/*",
    "https://login.northwesternmutual.com/*",
    "https://plan.northwesternmutual.com/*",
    "https://www.schwab.com/*",
    "https://client.schwab.com/*",
    "https://sws-gateway-nr.schwab.com/*",
    "https://www.wealthfront.com/*",
    "https://cdn.wealthfront.com/*",
    "https://www.bankofamerica.com/*",
    "https://secure.bankofamerica.com/*",
    "https://www.chase.com/*",
    "https://secure.chase.com/*",
    "https://*.chase.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Financial Institution Scraper"
  }
}
